# zixi-casino 環境變數範本
#
# 複製成 .env.local 後填值。.env.local 已被 .gitignore 擋住，不會進版控。
#
# ★ 2026-10-17：DATABASE_URL 現在是「必要」的 ——
#   apps/api/scripts/check_keys.mjs 與 migrate-kv-case.ts 原本把 Neon 的完整 DSN
#   （含密碼）硬寫在原始碼裡，已經進了 git 歷史。
#   現在改成讀 env，拿不到就明確失敗。
#
#   舊的 DSN 仍然存在於 git 歷史中 —— 密碼必須輪替，
#   改檔案不會讓歷史消失。輪替後舊密碼就失效了。

# --- 資料庫（必要）--------------------------
# Neon 後端要的是 -pooler 端點，不是直接連線端點。
# 佔位符號刻意用 <> 包住：一眼看出是佔位，也不會被憑據掃描器誤判成真實主機名。
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<NEON_POOLER_HOST>/neondb?sslmode=require

# 有些腳本也認這個名字（migrate-kv-case.ts 兩種都讀）
# POSTGRES_URL=

# --- 錢包 / 鏈上（zixi-wallet-app 相容層需要）------
# PRIVATE_KEY=
# TREASURY_ADDRESS=
# CHAIN_ID=11155111

# --- 外部服務 --------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# S3_BUCKET=
# SESSION_SECRET=
